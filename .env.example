# Copy this file to .env for local runs, or set the same names as real
# environment variables on your host (Render/Railway/Fly/Docker/Kubernetes).
# Never commit the filled-in .env.

# ---- Server ----
PORT=8081

# ---- PostgreSQL ----
# In Docker Compose the backend is pointed at the db service automatically.
DB_URL=jdbc:postgresql://localhost:5432/resource_allocation
DB_USERNAME=postgres
DB_PASSWORD=change-me
# Managed databases usually need TLS: append ?sslmode=require to DB_URL

# ---- Auth ----
# Must be at least 32 characters. Generate one with: openssl rand -base64 32
JWT_SECRET=change-me-to-a-long-random-string-32chars+
# Access-token lifetime in milliseconds (1 hour)
JWT_EXPIRATION=3600000
# Private code required to register as a coordinator
COORDINATOR_INVITE_CODE=change-me

# ---- CORS ----
# Comma-separated list of front-end origins that may call the API
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ---- AI (Gemini) ----
# Leave GEMINI_API_KEY blank to use the keyword-only fallback analysis.
GEMINI_API_KEY=
GEMINI_API_URL=https://generativelanguage.googleapis.com
GEMINI_MODEL=gemini-3.5-flash-lite

# ---- Uploads ----
# Use an absolute, mounted path in containers so images survive redeploys.
UPLOAD_DIR=./uploads/needs

# ---- Local demo only (never set these in production) ----
# SPRING_PROFILES_ACTIVE=dev
# SQL_INIT_MODE=always
